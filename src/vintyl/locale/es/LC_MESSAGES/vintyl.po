msgstr ""
"¿Cortar la prueba de cuchilla en <b>%(cutter)s</b>: un cuadrado de "
"%(size)g mm con un triángulo, cerca del origen?"

msgid "Cut the test"
msgstr "Cortar la prueba"

msgid "Cut this element"
msgstr "Cortar este elemento"

