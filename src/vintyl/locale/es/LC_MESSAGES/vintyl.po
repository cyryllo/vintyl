msgstr "El diseño cabe en una tira; no hay nada que dividir."

#, python-format
msgid ""
"The drawing has %d colour. Each goes to a colour of the design: check "
"what the program chose, and change it if you like."
msgid_plural ""
"The drawing has %d colours. Each goes to a colour of the design: check "
"what the program chose, and change it if you like."
msgstr[0] ""
"El dibujo tiene %d color. Cada uno va a un color del diseño: revisa lo "
"que eligió el programa y cámbialo si quieres."
msgstr[1] ""
"El dibujo tiene %d colores. Cada uno va a un color del diseño: revisa lo "
"que eligió el programa y cámbialo si quieres."

