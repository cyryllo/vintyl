#, python-format
msgid ""
"%s The knife offset and the overcut need %.2f mm of room; move the design"
" that far from the edge."
msgstr ""
"%s El desplazamiento de la cuchilla y el sobrecorte necesitan %.2f mm de "
"margen; aleja el diseño esa distancia del borde."

#, python-format
msgid "%s does not say its units. They are:"
msgstr "%s no indica sus unidades. Son:"

#, python-format
msgid "%s has no visible shapes to cut."
msgstr "%s no tiene formas visibles para cortar."

#, python-format
msgid "%s is damaged: a colour layer cannot be read."
msgstr "%s está dañado: no se puede leer una capa de color."

#, python-format
msgid "%s is damaged: an element cannot be read."
msgstr "%s está dañado: no se puede leer un elemento."

#, python-format
msgid "%s is damaged: it is not readable as a project."
msgstr "%s está dañado: no se puede leer como proyecto."

#, python-format
msgid "%s is not a Vintyl project."
msgstr "%s no es un proyecto de Vintyl."

#, python-format
msgid ""
"%s is not there now: plug the cutter in and switch it on, or choose its "
"port in the cutter's settings."
msgstr ""
"%s no está ahora: conecta y enciende el plóter, o elige su puerto en los "
"ajustes del plóter."

#, python-format
msgid "%s is not there. Is the cutter connected by USB and switched on?"
msgstr "%s no está. ¿Está el plóter conectado por USB y encendido?"

#, python-format
msgid "%s was saved by a newer Vintyl; please update Vintyl to open it."
msgstr "%s se guardó con un Vintyl más nuevo; actualiza Vintyl para abrirlo."

