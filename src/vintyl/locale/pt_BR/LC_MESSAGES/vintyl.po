msgstr ""
"%s não está presente agora: conecte e ligue a plotter, ou escolha a porta"
" dela nas configurações da plotter."

#, python-format
msgid "%s is not there. Is the cutter connected by USB and switched on?"
msgstr "%s não está presente. A plotter está conectada por USB e ligada?"

