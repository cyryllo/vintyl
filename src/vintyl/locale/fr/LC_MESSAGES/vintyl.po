msgstr ""
"%s n'est pas là pour l'instant : branchez et allumez le plotter, ou "
"choisissez son port dans les réglages du plotter."

#, python-format
msgid "%s is not there. Is the cutter connected by USB and switched on?"
msgstr "%s n'est pas là. Le plotter est-il branché en USB et allumé ?"

#, python-format
msgid "%s was saved by a newer Vintyl; please update Vintyl to open it."
msgstr ""
"%s a été enregistré par un Vintyl plus récent ; mettez Vintyl à jour pour"
