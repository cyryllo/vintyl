msgstr "&Plotter"

msgid "&Edit"
msgstr "&Bearbeiten"

msgid "&File"
msgstr "&Datei"

msgid "&Help"
msgstr "&Hilfe"

msgid "&Object"
msgstr "&Objekt"

msgid "&Settings"
msgstr "&Einstellungen"

msgid "&View"
msgstr "&Ansicht"

