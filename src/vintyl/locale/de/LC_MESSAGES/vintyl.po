msgid "%s is damaged: it is not readable as a project."
msgstr "%s ist beschädigt: es lässt sich nicht als Projekt lesen."

#, python-format
msgid "%s is not a Vintyl project."
msgstr "%s ist kein Vintyl-Projekt."

#, python-format
msgid ""
"%s is not there now: plug the cutter in and switch it on, or choose its "
"port in the cutter's settings."
msgstr ""
"%s ist gerade nicht da: den Plotter anschließen und einschalten oder "
"seinen Anschluss in den Plotter-Einstellungen wählen."

#, python-format
msgid "%s is not there. Is the cutter connected by USB and switched on?"
msgstr "%s ist nicht da. Ist der Plotter per USB angeschlossen und eingeschaltet?"

#, python-format
msgid "%s was saved by a newer Vintyl; please update Vintyl to open it."
msgstr ""
"%s wurde mit einem neueren Vintyl gespeichert; bitte Vintyl "
"aktualisieren, um es zu öffnen."

#, python-format
msgid "%s: unknown units %s."
msgstr "%s: unbekannte Einheiten %s."

